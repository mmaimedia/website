---
interface Props {
  title: string;
  description?: string;
  href: string;
  youtubeId: string;
  duration?: string;
}

const { title, description, href, youtubeId, duration } = Astro.props;
---

<article class="border border-light-200 dark:border-dark-300 rounded-sm overflow-hidden bg-[#657b83] dark:bg-dark-100 dark:hover:bg-dark-200 hover:border-primary/30 hover:shadow-orange transition-all duration-300">
  <div class="aspect-video bg-light-200 dark:bg-dark-200 relative">
    <img
      src={`https://img.youtube.com/vi/${youtubeId}/hqdefault.jpg`}
      alt={title}
      class="w-full h-full object-cover"
    />
    {duration && (
      <span class="absolute bottom-2 right-2 bg-[#657b83]/30 dark:bg-dark-100/80 text-milk dark:text-dark-900 text-xs px-2 py-1 rounded-sm border border-light-200 dark:border-dark-300">{duration}</span>
    )}
  </div>
  <div class="p-6">
    <h3 class="text-lg font-bold mb-2">
      <a href={href} class="text-light-800 dark:text-dark-900 hover:text-primary transition-colors">{title}</a>
    </h3>
    {description && (
      <p class="text-milk dark:text-dark-400 text-sm">{description}</p>
    )}
  </div>
</article>
