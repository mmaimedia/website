---
interface Props {
  title: string;
  description?: string;
  href: string;
  pubDate?: string;
  tags?: string[];
}

const { title, description, href, pubDate, tags } = Astro.props;
---

<article class="border border-light-200 dark:border-dark-300 rounded-sm p-6 bg-[#657b83] dark:bg-dark-100 dark:hover:bg-dark-200 hover:border-primary/30 hover:shadow-orange transition-all duration-300">
  <h3 class="text-xl font-bold mb-2">
    <a href={href} class="text-light-800 dark:text-dark-900 hover:text-primary transition-colors">{title}</a>
  </h3>
  {description && (
    <p class="text-milk dark:text-dark-400 text-sm mb-4">{description}</p>
  )}
  {pubDate && (
    <time class="text-xs text-milk dark:text-dark-500">{pubDate}</time>
  )}
  {tags && tags.length > 0 && (
    <div class="flex flex-wrap gap-2 mt-3">
      {tags.map(tag => (
        <span class="text-xs px-2 py-1 bg-light-100 dark:bg-dark-200 rounded-sm text-light-700 dark:text-dark-500 border border-light-200 dark:border-dark-300">{tag}</span>
      ))}
    </div>
  )}
</article>
