---
import ThemeToggle from './ThemeToggle.astro';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog' },
  { href: '/videos', label: 'Videos' },
  { href: '/podcasts', label: 'Podcasts' },
  { href: '/games', label: 'Games' },
  { href: '/about', label: 'About' },
];
---

<header class="relative border-b border-light-200 dark:border-dark-300 bg-light-100 dark:bg-dark-100">
  <div class="container mx-auto px-4 py-4 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3 whitespace-nowrap shrink-0">
      <img src={`${base}/images/logo.svg`} alt="MMAI Media Logo" class="h-10 w-auto" />
      <span class="text-xl font-bold text-primary">MMAI Media</span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-6">
      {navItems.map(item => (
        <a
          href={item.href}
          class="text-light-500 dark:text-dark-400 hover:text-primary transition-colors text-sm font-medium relative group"
        >
          {item.label}
          <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-teal transition-all group-hover:w-full"></span>
        </a>
      ))}
    </nav>

    <!-- Mobile hamburger + theme toggle -->
    <div class="md:hidden flex items-center gap-4">
      <button
        id="mobile-menu-button"
        class="p-2 text-light-700 dark:text-dark-400 hover:text-primary transition-colors"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
      <ThemeToggle />
    </div>

    <!-- Desktop theme toggle -->
    <div class="hidden md:block">
      <ThemeToggle />
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="md:hidden hidden absolute top-full left-0 right-0 bg-light-100 dark:bg-dark-100 border-t border-light-200 dark:border-dark-300 shadow-lg z-20"
  >
    <nav class="flex flex-col py-2">
      {navItems.map(item => (
        <a
          href={item.href}
          class="px-4 py-3 text-light-700 dark:text-dark-400 hover:text-primary hover:bg-light-50 dark:hover:bg-dark-200 transition-colors text-sm font-medium"
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>

  <script>
    const button = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');

    function updateAria() {
      if (button && menu) {
        const isExpanded = !menu.classList.contains('hidden');
        button.setAttribute('aria-expanded', String(isExpanded));
      }
    }

    button?.addEventListener('click', () => {
      menu?.classList.toggle('hidden');
      updateAria();
    });

    // Close menu when clicking a link
    menu?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        updateAria();
      });
    });

    // Close menu when clicking outside
    document.addEventListener('click', (e) => {
      if (menu && !menu.contains(e.target as Node) && !button?.contains(e.target as Node)) {
        menu.classList.add('hidden');
        updateAria();
      }
    });
  </script>
</header>
