---
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<section class="py-20 text-center">
  <div class="mx-auto px-4 max-w-3xl">
    <div class="text-6xl mb-6">🚧</div>
    <h1 class="text-3xl font-bold mb-4 text-light-800 dark:text-dark-900">Under Construction</h1>
    <p class="text-lg text-light-500 dark:text-dark-400 mb-8">
      This section is coming soon. Get launch updates by subscribing on the homepage.
    </p>
    <a
      href="/"
      class="inline-block bg-primary text-white px-8 py-4 text-lg font-semibold rounded-sm hover:bg-primaryHover transition-colors shadow-md"
    >
      Back to homepage
    </a>
  </div>
</section>
