---
// Theme toggle switch — toggles between light and dark mode
---

<button
  class="theme-toggle relative inline-flex h-9 w-17 items-center rounded-md border border-light-300 dark:border-dark-300 bg-light-200 dark:bg-dark-300 text-light-800 dark:text-dark-900 transition-colors hover:bg-light-300 dark:hover:bg-dark-400 focus:outline-none focus:ring-2 focus:ring-teal focus:ring-offset-2 dark:focus:ring-offset-dark-950"
  role="switch"
  aria-label="Toggle dark mode"
  aria-checked="true"
>
  <span class="absolute right-1 text-sm">☀️</span>
  <span class="absolute left-1 text-sm">🌙</span>
  <span
    class="theme-toggle-knob absolute top-0.5 left-0.5 h-8 w-8 rounded-md border border-light-200 dark:border-dark-200 bg-white dark:bg-dark-950 shadow transform transition-transform dark:translate-x-8"
  ></span>
</button>

<script>
  const toggles = document.querySelectorAll('.theme-toggle');
  const knobs = document.querySelectorAll('.theme-toggle-knob');
  const html = document.documentElement;

  function updateToggle() {
    const isDark = html.classList.contains('dark');
    toggles.forEach((toggle) => toggle.setAttribute('aria-checked', String(isDark)));
    knobs.forEach((knob) => {
      knob.style.transform = isDark ? 'translateX(32px)' : 'translateX(0)';
    });
  }

  // Initialize from localStorage or default to dark
  const saved = localStorage.getItem('theme');
  if (saved === 'light') {
    html.classList.remove('dark');
  } else {
    html.classList.add('dark');
  }
  updateToggle();

  toggles.forEach((toggle) => {
    toggle.addEventListener('click', () => {
      html.classList.toggle('dark');
      const isDark = html.classList.contains('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      updateToggle();
    });
  });
</script>
