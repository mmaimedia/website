---
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

const socialLinks = [
  { href: 'https://www.youtube.com/@MMAIMEDIA', label: 'YouTube', icon: '🎥' },
  // { href: 'https://spotify.com', label: 'Spotify', icon: '🎧' },
  // { href: 'https://patreon.com', label: 'Patreon', icon: '💎' },
  // { href: 'https://itch.io', label: 'Itch.io', icon: '🎮' },
  // { href: 'https://substack.com', label: 'Substack', icon: '📝' },
  // { href: 'https://ko-fi.com', label: 'Ko-fi', icon: '☕' },
  // { href: 'https://x.com', label: 'X', icon: '✕' },
  // { href: 'https://instagram.com', label: 'Instagram', icon: '📷' },
  // { href: 'https://bsky.app', label: 'Bluesky', icon: '🌤️' },
  // { href: 'https://twitch.tv', label: 'Twitch', icon: '🎮' },
  // { href: 'https://medium.com', label: 'Medium', icon: '✍️' },
];
---

<footer class="border-t border-light-200 dark:border-dark-300 bg-light-100 dark:bg-dark-100 py-12 text-light-600 dark:text-dark-400">
  <div class="container mx-auto px-4">
    <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-6">
      <div class="flex items-center gap-3">
        <img src={`${base}/images/logo.svg`} alt="MMAI Media Logo" class="h-8 w-auto" />
        <span class="text-lg font-bold text-primary">MMAI Media</span>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-4 max-w-full">
        {socialLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="flex-shrink-0 inline-flex items-center justify-center p-2 hover:opacity-80 transition-opacity relative group"
            aria-label={link.label}
          >
            <svg viewBox="0 0 24 24" class="h-7 w-auto" aria-hidden="true">
              <path
                fill="#FF0000"
                d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814z"
              />
              <path fill="#FFFFFF" d="M9.545 15.568V8.432L15.818 12z" />
            </svg>
            <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-teal transition-all group-hover:w-full"></span>
          </a>
        ))}
      </div>
    </div>

    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-4 text-sm text-light-500 dark:text-dark-500">
      <span>© {new Date().getFullYear()} MMAI Media LLC. All rights reserved.</span>
      <nav aria-label="Legal" class="flex items-center gap-4 sm:border-l sm:border-light-400 dark:sm:border-dark-300 sm:pl-4">
        <a href={`${base}/privacy/`} class="text-light-700 dark:text-dark-600 hover:text-primary dark:hover:text-primary hover:underline underline-offset-2 transition-colors">Privacy Policy</a>
        <a href={`${base}/terms/`} class="text-light-700 dark:text-dark-600 hover:text-primary dark:hover:text-primary hover:underline underline-offset-2 transition-colors">Terms of Service</a>
      </nav>
    </div>
  </div>
</footer>
