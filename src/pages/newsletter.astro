---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Newsletter | MMAI Media" description="Subscribe to the MMAI Media newsletter.">
  <section class="py-20">
    <div class="mx-auto px-4 max-w-3xl text-center">
      <div class="text-6xl mb-6">📝</div>
      <h1 class="text-3xl font-bold mb-4 text-light-800 dark:text-dark-900">MMAI Media Newsletter</h1>
      <p class="text-lg text-light-500 dark:text-dark-400 mb-8">
        Get the latest on game theory, AI, and gaming delivered to your inbox.
        Subscribe via Substack for weekly insights and updates.
      </p>
      <a
        href="https://substack.com"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-primary text-white px-8 py-4 text-lg font-semibold rounded-sm hover:bg-primaryHover transition-colors shadow-md"
      >
        Subscribe on Substack
      </a>
    </div>
  </section>
</Layout>
