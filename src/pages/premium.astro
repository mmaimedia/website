---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Premium | MMAI Media" description="Exclusive game theory and AI content on Patreon.">
  <section class="py-20">
    <div class="mx-auto px-4 max-w-3xl text-center">
      <div class="text-6xl mb-6">💎</div>
      <h1 class="text-3xl font-bold mb-4 text-light-800 dark:text-dark-900">MMAI Media Premium</h1>
      <p class="text-lg text-light-500 dark:text-dark-400 mb-8">
        Access exclusive content including extended courses, advanced game theory tutorials,
        and behind-the-scenes material.
      </p>
      <a
        href="https://patreon.com"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-primary text-white px-8 py-4 text-lg font-semibold rounded-sm hover:bg-primaryHover transition-colors shadow-md"
      >
        Join on Patreon
      </a>
    </div>
  </section>
</Layout>
