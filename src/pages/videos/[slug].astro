---
import Layout from '../../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
  const videos = await getCollection('videos');
  return videos.map(video => ({
    params: { slug: video.slug },
  }));
}

const { slug } = Astro.params;
const entry = await getEntry('videos', slug);
---

<Layout title={entry.data.title} description={entry.data.description}>
  <section class="py-20">
    <div class="mx-auto px-4 max-w-4xl">
      <h1 class="text-3xl font-bold mb-4 text-light-800 dark:text-dark-900">{entry.data.title}</h1>
      <time class="text-sm text-light-500 dark:text-dark-400 mb-6 block">{entry.data.pubDate.toLocaleDateString()}</time>

      <div class="aspect-video mb-6">
        <iframe
          src={`https://www.youtube.com/embed/${entry.data.youtubeId}`}
          title={entry.data.title}
          class="w-full h-full"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope"
          allowfullscreen
        ></iframe>
      </div>

      <div class="prose dark:prose-invert max-w-none">
        <slot />
      </div>
    </div>
  </section>
</Layout>
